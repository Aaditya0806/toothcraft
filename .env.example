# Copy this file to .env.local and fill in the values you need.
# Nothing here is required to run the site locally.

# Public address of the website (used for canonical URLs, the sitemap and structured data).
NEXT_PUBLIC_SITE_URL=https://www.toothcrafts.com

# ---------------------------------------------------------------------------
# Appointment form delivery
# ---------------------------------------------------------------------------
# The form at /contact posts to /api/enquiry. Until ONE of the two options
# below is configured, the form honestly tells visitors that online requests
# are unavailable and offers WhatsApp / phone instead. It never shows a
# success message for a request that was not delivered.

# Option A — email via SMTP (e.g. the mailbox for info@toothcrafts.com)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=true            # set for port 465; inferred automatically if omitted
# ENQUIRY_TO=info@toothcrafts.com   # where requests are sent (defaults to info@toothcrafts.com)
# ENQUIRY_FROM="ToothCraft Website <website@toothcrafts.com>"

# Option B — POST each request as JSON to a webhook (Zapier, Make, Google Apps Script, a CRM…)
# ENQUIRY_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
# Google Tag Manager container. The previous website used GTM-KGZ8XFPT.
# NEXT_PUBLIC_GTM_ID=

# ---------------------------------------------------------------------------
# Development convenience (optional)
# ---------------------------------------------------------------------------
# Stop Turbopack writing its compile cache to disk (useful when free disk space is very low).
# NEXT_NO_DISK_CACHE=1
